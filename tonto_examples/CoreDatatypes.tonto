package CoreDatatypes

datatype PhoneNumberDataType {
  countryCode: IntDataType
  bodyNumber: IntDataType
}

datatype IntDataType specializes number

enum EyeColor {
  Blue,
  Green,
  Brown,
  Black,
  Other
}

datatype AddressDataType {
  country: string
  city: string
  postalCode: string
  street: string
  number: string
  complement: string
}