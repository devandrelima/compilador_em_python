package CoreDatatypes

datatype PhoneNumber {
  countryCode: Int
  bodyNumber: Int
}

datatype Int specializes number

enum EyeColor {
  Blue,
  Green,
  Brown,
  Black,
  Other
}

datatype Address {
  country: string
  city: string
  postalCode: string
  street: string
  number: string
  complement: string
}